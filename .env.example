# Box CCG (server only). Leave blank to keep the fixture library.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
# Library folder that contains public/ and partner/ children
BOX_LIBRARY_FOLDER_ID=
# Demo logins → Box App User ids (As-User). Preferred over the single-account vars below.
# Create App Users in Box, collaborate each on partner files, then either:
#   copy demo-reviewers.example.json to demo-reviewers.json, or set DEMO_REVIEWERS.
# DEMO_REVIEWERS=[{"email":"alex@example.com","password":"review-alex","boxUserId":"123456"}]

# Fallback when DEMO_REVIEWERS / demo-reviewers.json are unset (one reviewer)
BOX_DEMO_PARTNER_USER_ID=
DEMO_PARTNER_EMAIL=partner@example.com
DEMO_PARTNER_PASSWORD=partner

# Webhook HMAC (primary signature key from the Box webhook). Without this, events are ignored.
BOX_WEBHOOK_SIGNATURE_KEY=
# Optional: POST /api/revalidate?secret=...&fileId=...
REVALIDATE_SECRET=

# AI Gateway uses Vercel OIDC on deploy; local:
AI_GATEWAY_API_KEY=
# ASK_MODEL=openai/gpt-4.1-mini
